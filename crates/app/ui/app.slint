// Geist (OFL-1.1, assets/fonts/OFL.txt), embedded so text matches vaexil.tv.
import "../../../assets/fonts/Geist-Regular.ttf";
import "../../../assets/fonts/Geist-SemiBold.ttf";
import "../../../assets/fonts/Geist-Bold.ttf";
import "../../../assets/fonts/GeistMono-Regular.ttf";
import { LineEdit, Palette, ScrollView } from "std-widgets.slint";
import { Button, Switch, Theme } from "theme.slint";

export struct DeviceRow {
    // Product name and location: how the actions find the device again.
    name-key: string,
    location-key: string,
    // "", "kept", "differs" or "changed"
    status: string,
    status-text: string,
    can-keep: bool,
    // Every light is off: Keep asks before keeping it dark.
    dark: bool,
    // It was kept before you stopped keeping it: "Keep it as before".
    has-before: bool,
    // One of its modes takes a color: the row offers "Color…".
    can-color: bool,
    // It runs a lighting mode of its own, so its colors are unknown.
    own-lighting: bool,
    // What probably lights it, after "Lit by: "; warn when another app may
    // fight Keeplight over it.
    lit-by: string,
    lit-by-warn: bool,
    name: string,
    product: string,
    meta: string,
    zones: string,
    note: string,
    // False when every light on the device is off; the swatch is then hollow.
    lit: bool,
    swatch: color,
}

export global Ui {
    in property <string> version;
    // "devices" or "message"
    in property <string> screen: "message";
    in property <string> chip: "Connecting…";
    in property <bool> chip-warn;
    in property <string> heading: "Looking for OpenRGB";
    in property <string> message;
    in property <string> summary;
    in property <[DeviceRow]> devices;
    // The last action's result, or a problem with the saved setup.
    in property <string> notice;
    in property <bool> notice-warn;
    // True from a button press until the window next refreshes.
    in-out property <bool> busy;
    callback keep(DeviceRow);
    callback put-back(DeviceRow);
    callback keep-dark(DeviceRow);
    callback stop-keeping(DeviceRow);
    callback keep-as-before(DeviceRow);
    // A color as #rrggbb, set and kept.
    callback set-color(DeviceRow, string);
    // The keeper at sign-in.
    in-out property <bool> sign-in;
    in property <string> sign-in-note;
    in property <string> last-run;
    callback set-sign-in(bool);
    // The keeper's icon in the notification area (off by default).
    in-out property <bool> tray-icon;
    callback set-tray-icon(bool);
    // "Let AI tools make changes" (aiChanges, off by default), and each AI
    // app's line for connecting to keeplight-cli's MCP server.
    in-out property <bool> ai-changes;
    callback set-ai-changes(bool);
    in property <string> mcp-claude;
    in property <string> mcp-gemini;
    in property <string> mcp-codex;
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> warn;
    height: 28px;
    min-width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: (warn ? Theme.warning : Theme.ready).transparentize(86%);
    border-width: 1px;
    border-color: (warn ? Theme.warning : Theme.ready).transparentize(50%);
    label := Text {
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: root.warn ? Theme.warning : Theme.ready;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The color most of a device's lights show, as a disc. Off is a hollow ring.
component Swatch inherits Rectangle {
    in property <bool> lit;
    in property <color> fill;
    // A mode of its own: colors unknown, shown as a spectrum.
    in property <bool> own;
    width: 28px;
    height: 28px;
    border-radius: self.width / 2;
    // The software renderer doesn't round gradient fills, so the spectrum is
    // a radial gradient that fades out before the corners and looks round.
    background: root.own
        ? @radial-gradient(circle, #ffd23f 0%, #ff3b6b 40%, #3bd5ff 68%, #3bd5ff00 72%)
        : root.lit ? root.fill : transparent;
    border-width: root.own ? 0px : root.lit ? 1px : 2px;
    border-color: root.lit ? Theme.surface-border : Theme.secondary-text.transparentize(40%);
    accessible-role: none;
}

// One-click colors for a device: common colors, or any #rrggbb. Picking one
// sets it and keeps it.
component ColorDot inherits Rectangle {
    in property <color> fill;
    in property <string> label;
    callback picked();
    width: 26px;
    height: 26px;
    border-radius: self.width / 2;
    background: root.fill;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? Theme.text : Theme.surface-border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.picked(); }
    touch := TouchArea {
        enabled: !Ui.busy;
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component ColorPicker inherits HorizontalLayout {
    in property <DeviceRow> item;
    callback done();
    spacing: 8px;
    alignment: start;
    for c in [
        { fill: #ff0000, hex: "#ff0000", name: "red" },
        { fill: #ff6a00, hex: "#ff6a00", name: "orange" },
        { fill: #ffd200, hex: "#ffd200", name: "yellow" },
        { fill: #00ff40, hex: "#00ff40", name: "green" },
        { fill: #00e5ff, hex: "#00e5ff", name: "cyan" },
        { fill: #0050ff, hex: "#0050ff", name: "blue" },
        { fill: #8a2be2, hex: "#8a2be2", name: "purple" },
        { fill: #ff2d95, hex: "#ff2d95", name: "pink" },
        { fill: #ffffff, hex: "#ffffff", name: "white" },
    ]: VerticalLayout {
        alignment: center;
        ColorDot {
            fill: c.fill;
            label: "Set " + root.item.name + " to " + c.name;
            picked => {
                Ui.set-color(root.item, c.hex);
                root.done();
            }
        }
    }
    hex := LineEdit {
        placeholder-text: "#rrggbb";
        width: 100px;
        font-size: 12px;
        accessible-label: "Color for " + root.item.name + " as #rrggbb";
        accepted => {
            Ui.set-color(root.item, self.text);
            root.done();
        }
    }
    Button {
        text: "Set";
        enabled: !Ui.busy && hex.text != "";
        accessible-label: "Set " + root.item.name + " to the color typed";
        clicked => {
            Ui.set-color(root.item, hex.text);
            root.done();
        }
    }
    Button {
        text: "Cancel";
        accessible-label: "Close the colors for " + root.item.name;
        clicked => { root.done(); }
    }
}

component DeviceRowView inherits Rectangle {
    in property <DeviceRow> item;
    // Showing "Keep every light off?" for a dark device.
    property <bool> confirm-dark;
    min-height: content.preferred-height;
    border-radius: Theme.control-radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.surface-border;
    accessible-role: list-item;
    accessible-label: root.item.name + ", " + root.item.product + ", " + root.item.meta
        + (root.item.own-lighting ? "" : root.item.lit ? "" : ", all lights off") + "."
        // The note and status are sentences that end in their own period.
        + (root.item.note != "" ? " " + root.item.note : "")
        + (root.item.status-text != "" ? " " + root.item.status-text : "")
        + (root.item.lit-by != "" ? " Lit by " + root.item.lit-by + "." : "");

    // Showing the color picker under the row.
    property <bool> picking;
    content := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                Swatch {
                    lit: root.item.lit;
                    own: root.item.own-lighting;
                    fill: root.item.swatch;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.item.name;
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                        horizontal-stretch: 0;
                        accessible-role: none;
                    }
                    Text {
                        text: root.item.product;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        accessible-role: none;
                    }
                }
                Text {
                    text: root.item.meta;
                    font-size: 12px;
                    font-family: Theme.font-mono;
                    color: Theme.secondary-text;
                    overflow: elide;
                    accessible-role: none;
                }
                if root.item.zones != "": Text {
                    text: root.item.zones;
                    font-size: 12px;
                    color: Theme.secondary-text;
                    wrap: word-wrap;
                    accessible-role: none;
                }
                if root.item.note != "": Text {
                    text: root.item.note;
                    font-size: 12px;
                    color: Theme.warning;
                    wrap: word-wrap;
                    accessible-role: none;
                }
                if root.item.lit-by != "": Text {
                    text: "Lit by: " + root.item.lit-by;
                    font-size: 12px;
                    color: root.item.lit-by-warn ? Theme.warning : Theme.secondary-text;
                    wrap: word-wrap;
                    accessible-role: none;
                }
                if root.item.status-text != "": Text {
                    text: root.item.status-text;
                    font-size: 12px;
                    color: root.item.status == "kept" ? Theme.ready
                        : root.item.status == "" ? Theme.secondary-text : Theme.warning;
                    wrap: word-wrap;
                    accessible-role: none;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                if root.item.can-color && !root.picking: Button {
                    text: "Color…";
                    enabled: !Ui.busy;
                    accessible-label: "Choose a color for " + root.item.name;
                    clicked => { root.picking = true; }
                }
                if root.item.has-before: Button {
                    text: "Keep it as before";
                    primary: root.item.status == "";
                    enabled: !Ui.busy;
                    accessible-label: "Keep " + root.item.name + " as before";
                    clicked => { Ui.keep-as-before(root.item); }
                }
                // On every kept device: after a power cut the lights can differ
                // while OpenRGB's record still matches.
                if root.item.status != "": Button {
                    text: "Put back";
                    primary: root.item.status == "differs";
                    enabled: !Ui.busy;
                    accessible-label: "Put back " + root.item.name;
                    clicked => { Ui.put-back(root.item); }
                }
                if root.item.status != "kept" && !(root.confirm-dark && root.item.dark): Button {
                    text: root.item.dark ? "Keep it dark…" : root.item.status == "" ? "Keep this" : "Keep this instead";
                    enabled: root.item.can-keep && !Ui.busy;
                    accessible-label: (root.item.status == "" ? "Keep " : "Keep what this shows now, ") + root.item.name;
                    clicked => {
                        if (root.item.dark) {
                            root.confirm-dark = true;
                        } else {
                            Ui.keep(root.item);
                        }
                    }
                }
                // Asking before keeping a device dark (owner rule, 2026-10-23).
                // The question only stands while the device is still dark.
                if root.confirm-dark && root.item.dark: Text {
                    text: "Keep every light off, even after sleep?";
                    font-size: 12px;
                    color: Theme.warning;
                    wrap: word-wrap;
                    max-width: 180px;
                }
                if root.confirm-dark && root.item.dark: Button {
                    text: "Keep it dark";
                    primary: true;
                    enabled: !Ui.busy;
                    accessible-label: "Keep " + root.item.name + " dark";
                    clicked => {
                        root.confirm-dark = false;
                        Ui.keep-dark(root.item);
                    }
                }
                if root.confirm-dark && root.item.dark: Button {
                    text: "Cancel";
                    accessible-label: "Don't keep " + root.item.name + " dark";
                    clicked => { root.confirm-dark = false; }
                }
                if root.item.status != "": Button {
                    text: "Stop keeping";
                    enabled: !Ui.busy;
                    accessible-label: "Stop keeping " + root.item.name;
                    clicked => { Ui.stop-keeping(root.item); }
                }
            }
        }
        if root.picking: ColorPicker {
            item: root.item;
            done => { root.picking = false; }
        }
    }
}

export component AppWindow inherits Window {
    title: "Keeplight";
    icon: @image-url("../../../assets/icon-256.png");
    preferred-width: 860px;
    preferred-height: 720px;
    min-width: 420px;
    min-height: 480px;
    background: Theme.window-background;
    default-font-size: 13px;
    default-font-family: Theme.font-sans;

    // Dark by default (owner decision 2026-10-24). The setting to follow
    // Windows or use light comes with the settings screen.
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    property <length> gutter: 24px;

    // After a restore from minimized, the software renderer's partial repaint
    // left everything outside changed items unpainted. Flipping this flag
    // (from Rust) changes the full-window rectangle's colour by one step,
    // which marks the whole window dirty and repaints all of it.
    in property <bool> repaint-flip;
    Rectangle {
        background: root.repaint-flip ? Theme.window-background-alt : Theme.window-background;
        accessible-role: none;
    }

    VerticalLayout {
        HorizontalLayout {
            padding: gutter;
            padding-top: 22px;
            padding-bottom: 14px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                Text {
                    text: "Your lights";
                    font-size: 26px;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if Ui.summary != "": Text {
                    text: Ui.summary;
                    font-size: 12px;
                    color: Theme.secondary-text;
                }
                if Ui.notice != "": Text {
                    text: Ui.notice;
                    font-size: 12px;
                    color: Ui.notice-warn ? Theme.warning : Theme.ready;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }
            VerticalLayout {
                alignment: center;
                Chip {
                    text: Ui.chip;
                    warn: Ui.chip-warn;
                }
            }
        }

        HorizontalLayout {
            padding-left: gutter;
            padding-right: gutter;
            padding-bottom: 12px;
            Rectangle {
                min-height: sign-in-box.preferred-height;
                border-radius: Theme.control-radius;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface-border;
                sign-in-box := VerticalLayout {
                    padding: 14px;
                    padding-left: 16px;
                    spacing: 4px;
                    Switch {
                        text: "Put kept lights back when you sign in";
                        checked <=> Ui.sign-in;
                        toggled => { Ui.set-sign-in(self.checked); }
                    }
                    Text {
                        text: Ui.sign-in-note;
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    Switch {
                        text: "Show the keeper's icon in the notification area";
                        checked <=> Ui.tray-icon;
                        toggled => { Ui.set-tray-icon(self.checked); }
                    }
                    Switch {
                        text: "Let AI tools make changes";
                        checked <=> Ui.ai-changes;
                        toggled => { Ui.set-ai-changes(self.checked); }
                    }
                    Text {
                        text: Ui.ai-changes
                            ? "AI tools you connect can keep, put back and stop keeping devices when you ask. Each change is planned first and recorded with your request."
                            : "Off: AI tools you connect can read your lights and plan changes, but change nothing. To connect one, run its line once in a terminal (click a line, then Ctrl+A and Ctrl+C):";
                        font-size: 12px;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                    for line in [Ui.mcp-claude, Ui.mcp-gemini, Ui.mcp-codex]: LineEdit {
                        text: line;
                        read-only: true;
                        font-size: 11px;
                        accessible-label: "Command to connect an AI app: " + line;
                    }
                    if Ui.last-run != "": Text {
                        text: "Last run: " + Ui.last-run;
                        font-size: 12px;
                        font-family: Theme.font-mono;
                        color: Theme.secondary-text;
                        wrap: word-wrap;
                    }
                }
            }
        }

        if Ui.screen == "devices": list := ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                width: list.visible-width;
                // Rows keep their own height when there are only a few.
                alignment: start;
                padding-left: gutter;
                padding-right: gutter;
                padding-bottom: gutter;
                spacing: 8px;
                for d in Ui.devices: DeviceRowView { item: d; }
            }
        }

        if Ui.screen == "message": VerticalLayout {
            vertical-stretch: 1;
            padding: gutter * 2;
            alignment: center;
            spacing: 12px;
            Text {
                text: Ui.heading;
                font-size: 22px;
                font-weight: 700;
                color: Theme.text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            Text {
                text: Ui.message;
                color: Theme.secondary-text;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            padding-left: gutter;
            padding-right: gutter;
            padding-top: 8px;
            padding-bottom: 12px;
            Text {
                text: "Keeplight changes a light only when you press Put back or pick a color, and at sign-in, after sleep and when OpenRGB's devices change while the switch above is on. Version " + Ui.version + ".";
                font-size: 11px;
                color: Theme.secondary-text;
                wrap: word-wrap;
            }
        }
    }
}

/// A plain message for errors before the main window exists.
export component MessageWindow inherits Window {
    in property <string> heading;
    in property <string> message;
    callback ok();

    title: "Keeplight";
    icon: @image-url("../../../assets/icon-256.png");
    width: 440px;
    background: Theme.surface;
    default-font-size: 13px;
    default-font-family: Theme.font-sans;
    forward-focus: ok-button;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Text {
            text: root.heading;
            font-size: 18px;
            font-weight: 700;
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.message;
            color: Theme.text;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            ok-button := Button {
                text: "OK";
                primary: true;
                clicked => { root.ok(); }
            }
        }
    }
}
